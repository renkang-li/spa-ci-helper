{
  "manifest_version": 3,
  "name": "SPA CI Helper",
  "description": "Batch merge GitLab merge requests and trigger release jobs with the current browser login session.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SPA CI Helper"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://git.papamk.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://git.papamk.com/*"],
  "permissions": ["storage", "tabs", "windows"]
}
